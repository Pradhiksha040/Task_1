<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cognifyz Task 1 - HTML Structure & Server Interaction</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    
    <!-- Semantic Header Component -->
    <header>
      <span class="badge">Task 1 - Full Stack Basics</span>
      <h1>Express & EJS Interaction</h1>
      <p class="subtitle">HTML Structure, Form Submission, and Server-Side Rendering</p>
    </header>

    <!-- Semantic Main Content Area -->
    <main>
      <section class="card">
        
        <!-- Introduction Section -->
        <div class="card-intro">
          <h2>Send Us a Message</h2>
          <p>This beginner-friendly application demonstrates basic HTML form interaction with a Node.js + Express backend using EJS server-side rendering.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert-error">
            <svg width="20" height="20" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <!-- User Input Form with Semantic Elements & Client-Side Validation -->
        <form action="/submit" method="POST" id="contactForm">
          
          <!-- Name Field -->
          <div class="form-group">
            <label for="name">
              Full Name <span class="required-star">*</span>
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              placeholder="e.g., Alex Johnson" 
              required 
              minlength="2"
              autocomplete="name"
            >
          </div>

          <!-- Email Field -->
          <div class="form-group">
            <label for="email">
              Email Address <span class="required-star">*</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              placeholder="e.g., alex@example.com" 
              required 
              autocomplete="email"
            >
          </div>

          <!-- Message Field -->
          <div class="form-group">
            <label for="message">
              Message <span class="required-star">*</span>
            </label>
            <textarea 
              id="message" 
              name="message" 
              placeholder="Write your message here..." 
              required 
              minlength="5"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-submit" id="submitBtn">
            <span>Submit Data to Server</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>

        </form>
      </section>
    </main>

    <!-- Semantic Footer Component -->
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> Cognifyz IT Solutions. Internship Task 1.</p>
    </footer>

  </div>
</body>
</html>
