<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <%- include('partials/head', { title: 'Cognifyz LaunchPad - Tasks 2 to 8 Full Stack App' }) %>
</head>
<body class="d-flex flex-column min-vh-100 bg-dark-gradient text-light">

  <!-- Responsive Navigation Bar -->
  <%- include('partials/navbar') %>

  <!-- Main View Container supporting Single Page Client-Side Routing (Task 4) -->
  <main class="flex-shrink-0 mt-5 pt-4">

    <!-- Section 1: Hero Banner (Home View) -->
    <div id="section-hero" class="page-section active">
      <%- include('partials/hero') %>
    </div>

    <div class="container">
      <!-- Section 2: Registration Form (Task 2 & Task 4) -->
      <div id="section-register" class="page-section">
        <%- include('partials/taskForm') %>
      </div>

      <!-- Section 3: Users REST API & Submissions Table (Task 2 & Task 5 & Task 6) -->
      <div id="section-users" class="page-section">
        <%- include('partials/userTable') %>
      </div>

      <!-- Section 4: External API & OAuth 2.0 (Task 7) -->
      <div id="section-external" class="page-section">
        <%- include('partials/externalApi') %>
      </div>

      <!-- Section 5: Features Overview & Architecture (Task 3 & About View) -->
      <div id="section-about" class="page-section">
        <%- include('partials/features') %>
      </div>
    </div>

  </main>

  <!-- Modals -->
  <%- include('partials/loginModal') %>
  <%- include('partials/oauthModal') %>
  <%- include('partials/termsModal') %>

  <!-- Responsive Footer -->
  <%- include('partials/footer') %>

  <!-- Bootstrap 5 Bundle JS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/bootstrap.bundle.min.js"></script>

  <!-- Client-Side Scripts for Validation, Router, REST API, & OAuth Demo -->
  <script src="/js/validation.js"></script>
  <script src="/js/router.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/oauthDemo.js"></script>
</body>
</html>
