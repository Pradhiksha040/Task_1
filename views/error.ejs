<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Validation Error - Cognifyz Task 1</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    
    <header>
      <span class="badge" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3); color: #fca5a5;">
        Validation Error
      </span>
      <h1>Invalid Submission</h1>
    </header>

    <main>
      <section class="card" style="text-align: center;">
        
        <div style="margin-bottom: 24px;">
          <div style="width: 64px; height: 64px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: var(--error); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h2>Required Fields Missing</h2>
          <p class="subtitle" style="margin-top: 8px;"><%= errorMessage %></p>
        </div>

        <div class="action-bar">
          <a href="/" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Return to Form</span>
          </a>
        </div>

      </section>
    </main>

    <footer>
      <p>&copy; <%= new Date().getFullYear() %> Cognifyz IT Solutions.</p>
    </footer>

  </div>
</body>
</html>
