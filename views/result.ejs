<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submission Received - Cognifyz Task 1</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    
    <!-- Header Component -->
    <header>
      <span class="badge">Server-Side Rendered View</span>
      <h1>Form Submission Success</h1>
    </header>

    <!-- Main Content Card -->
    <main>
      <section class="card">
        
        <div class="result-header">
          <div class="success-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <!-- Dynamic Greeting using EJS variable -->
          <h2>Thank You, <%= name %>!</h2>
          <p class="subtitle">Your form data was successfully submitted and processed by Express.</p>
        </div>

        <!-- Dynamic Data Display Section using EJS interpolation -->
        <div class="data-display">
          
          <div class="data-row">
            <div class="data-label">Submitted Name</div>
            <div class="data-value" id="displayName"><%= name %></div>
          </div>

          <div class="data-row">
            <div class="data-label">Submitted Email</div>
            <div class="data-value" id="displayEmail"><%= email %></div>
          </div>

          <div class="data-row">
            <div class="data-label">Submitted Message</div>
            <div class="data-value message-box" id="displayMessage"><%= message %></div>
          </div>

          <% if (typeof submittedAt !== 'undefined' && submittedAt) { %>
            <div class="data-row">
              <div class="data-label">Received At (Server Time)</div>
              <div class="data-value" style="font-size: 0.85rem; color: var(--text-muted);"><%= submittedAt %></div>
            </div>
          <% } %>

        </div>

        <!-- Navigation Action -->
        <div class="action-bar">
          <a href="/" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Submit Another Message</span>
          </a>
        </div>

      </section>
    </main>

    <!-- Semantic Footer -->
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> Cognifyz IT Solutions. Task 1 Server-Side Rendering Demo.</p>
    </footer>

  </div>
</body>
</html>
