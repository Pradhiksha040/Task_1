<!-- Task 2 & Task 4 Complex Registration Form Partial -->
<div class="card glass-card shadow-lg border-0 rounded-4 p-4 p-md-5 my-4">
  <div class="card-intro mb-4 text-center">
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold mb-2">
      Task 2 & 4 Interactive Registration Form
    </span>
    <h2 class="fw-bold text-white mb-2">User Registration & Validation</h2>
    <p class="text-muted fs-6 mb-0">Fill in all fields to test real-time client-side validation, server-side validation, password strength indicators, and background processing.</p>
  </div>

  <!-- Dynamic Form Alert Banner -->
  <div id="formAlert" class="alert mb-4" style="display: none;" role="alert"></div>

  <form id="complexForm" novalidate>
    <div class="row g-3">
      <!-- Full Name -->
      <div class="col-md-6 form-group mb-3">
        <label for="fullName" class="form-label text-light fw-semibold">
          Full Name <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-person"></i></span>
          <input type="text" class="form-control bg-dark border-secondary text-light" id="fullName" name="fullName" placeholder="e.g., Alex Johnson" required minlength="2">
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Email Address -->
      <div class="col-md-6 form-group mb-3">
        <label for="email" class="form-label text-light fw-semibold">
          Email Address <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-envelope"></i></span>
          <input type="email" class="form-control bg-dark border-secondary text-light" id="email" name="email" placeholder="e.g., alex@example.com" required>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Phone Number -->
      <div class="col-md-6 form-group mb-3">
        <label for="phone" class="form-label text-light fw-semibold">
          Phone Number <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-telephone"></i></span>
          <input type="tel" class="form-control bg-dark border-secondary text-light" id="phone" name="phone" placeholder="e.g., +1 555-0199" required>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Date of Birth -->
      <div class="col-md-6 form-group mb-3">
        <label for="dob" class="form-label text-light fw-semibold">
          Date of Birth <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-calendar-date"></i></span>
          <input type="date" class="form-control bg-dark border-secondary text-light" id="dob" name="dob" required>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Gender -->
      <div class="col-md-6 form-group mb-3">
        <label for="gender" class="form-label text-light fw-semibold">
          Gender <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-gender-ambiguous"></i></span>
          <select class="form-select bg-dark border-secondary text-light" id="gender" name="gender" required>
            <option value="" selected disabled>-- Select Gender --</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
            <option value="Prefer not to say">Prefer not to say</option>
          </select>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- City -->
      <div class="col-md-6 form-group mb-3">
        <label for="city" class="form-label text-light fw-semibold">
          City <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-geo-alt"></i></span>
          <input type="text" class="form-control bg-dark border-secondary text-light" id="city" name="city" placeholder="e.g., New York" required>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Address with Live Character Counter (Task 4) -->
      <div class="col-12 form-group mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label for="address" class="form-label text-light fw-semibold mb-0">
            Full Address <span class="text-danger">*</span>
          </label>
          <small class="text-muted" id="addressCharCount">0 / 250 characters</small>
        </div>
        <textarea class="form-control bg-dark border-secondary text-light" id="address" name="address" rows="2" placeholder="Street name, apartment, area code..." maxlength="250" required></textarea>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Password Field with Show/Hide Toggle and Strength Indicator (Task 4) -->
      <div class="col-md-6 form-group mb-3">
        <label for="password" class="form-label text-light fw-semibold">
          Password <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-lock"></i></span>
          <input type="password" class="form-control bg-dark border-secondary text-light" id="password" name="password" placeholder="Min 8 chars (upper, lower, num, symbol)" required>
          <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn">
            <i class="bi bi-eye"></i>
          </button>
        </div>
        
        <!-- Task 4 Dynamic Password Strength Bar -->
        <div class="mt-2" id="passwordStrengthContainer">
          <div class="progress" style="height: 6px;">
            <div class="progress-bar transition-all" id="strengthMeterFill" role="progressbar" style="width: 0%;"></div>
          </div>
          <small class="form-text d-block mt-1 fw-semibold" id="strengthText"></small>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Confirm Password Field -->
      <div class="col-md-6 form-group mb-3">
        <label for="confirmPassword" class="form-label text-light fw-semibold">
          Confirm Password <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-shield-lock"></i></span>
          <input type="password" class="form-control bg-dark border-secondary text-light" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" required>
          <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPasswordBtn">
            <i class="bi bi-eye"></i>
          </button>
        </div>
        <div class="invalid-feedback"></div>
      </div>

      <!-- Terms & Conditions Checkbox -->
      <div class="col-12 form-group mb-4">
        <div class="form-check">
          <input class="form-check-input bg-dark border-secondary" type="checkbox" id="termsAccepted" name="termsAccepted" required>
          <label class="form-check-label text-light" for="termsAccepted">
            I agree to the <a href="#" class="text-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#termsModal">Terms & Conditions</a> and Privacy Policy. <span class="text-danger">*</span>
          </label>
          <div class="invalid-feedback">You must accept the terms before submitting.</div>
        </div>
      </div>

      <!-- Action Buttons: Submit & Reset -->
      <div class="col-12 d-flex flex-column flex-sm-row gap-3 pt-2">
        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 rounded-pill shadow" id="submitBtn">
          <span>Submit Registration</span> <i class="bi bi-send-fill ms-2"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-lg rounded-pill px-4" id="resetBtn">
          <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
        </button>
      </div>
    </div>
  </form>
</div>
