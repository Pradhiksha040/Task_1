<!-- Task 2 & Task 5 REST API User Management Partial -->
<div class="card glass-card shadow-lg border-0 rounded-4 p-4 p-md-5 my-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold mb-2">
        Task 5 REST API & Task 2 Temporary Store
      </span>
      <h2 class="fw-bold text-white mb-0">Registered Users & Submissions</h2>
    </div>

    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-info rounded-pill px-3" id="refreshUsersBtn">
        <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
      </button>
      <button class="btn btn-sm btn-outline-warning rounded-pill px-3" id="toggleStoreViewBtn">
        <i class="bi bi-layers me-1"></i> Switch: <span id="storeModeLabel">REST Users API</span>
      </button>
    </div>
  </div>

  <!-- Cache Status Banner (Task 8) -->
  <div class="alert alert-dark d-flex align-items-center justify-content-between rounded-3 py-2 px-3 mb-3 border-secondary" id="cacheBanner">
    <div class="d-flex align-items-center gap-2 text-muted small">
      <i class="bi bi-hdd-network text-info"></i>
      <span id="cacheStatusText">Cache Engine: Initializing...</span>
    </div>
    <span class="badge bg-secondary-subtle text-light" id="cacheHitBadge">Fresh DB Query</span>
  </div>

  <!-- User Table Container -->
  <div class="table-responsive rounded-3 border border-secondary">
    <table class="table table-dark table-hover align-middle mb-0" id="usersTable">
      <thead>
        <tr class="table-dark text-muted uppercase small">
          <th>#</th>
          <th>Full Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>City</th>
          <th>DOB</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody">
        <tr>
          <td colspan="7" class="text-center text-muted py-4">
            <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span> Loading registered users...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Edit User Modal (Task 5 CRUD) -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title fw-bold" id="editUserModalLabel"><i class="bi bi-pencil-square me-2 text-primary"></i> Edit User Profile</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editUserForm">
          <input type="hidden" id="editUserId">
          <div class="mb-3">
            <label for="editFullName" class="form-label text-muted">Full Name</label>
            <input type="text" class="form-control bg-dark border-secondary text-light" id="editFullName" required>
          </div>
          <div class="mb-3">
            <label for="editEmail" class="form-label text-muted">Email Address</label>
            <input type="email" class="form-control bg-dark border-secondary text-light" id="editEmail" required>
          </div>
          <div class="mb-3">
            <label for="editPhone" class="form-label text-muted">Phone Number</label>
            <input type="tel" class="form-control bg-dark border-secondary text-light" id="editPhone" required>
          </div>
          <div class="mb-3">
            <label for="editCity" class="form-label text-muted">City</label>
            <input type="text" class="form-control bg-dark border-secondary text-light" id="editCity" required>
          </div>
          <div class="d-flex justify-content-end gap-2 pt-2">
            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill"><i class="bi bi-save me-1"></i> Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
